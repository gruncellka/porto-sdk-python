# Porto SDK Python - Environment Variables
# Copy this file to .env and fill in your credentials
# .env is gitignored for security
#
# IMPORTANT: Use Portokasse username/password, NOT DHL Developer Portal API keys

# Porto Features Path (OPTIONAL - BDD features from gruncellka-porto-features package by default)
# Set only for custom local feature overrides: PORTO_FEATURES_PATH=/absolute/path/to/porto-features

# Internetmarke API Credentials (OPTIONAL - only needed for stamp generation)
# If provided: can generate stamps via API
# If not provided: validation/pricing still work (use porto-data), but stamp generation unavailable

# Level 1 (App): DHL Developer Portal - developer.dhl.com
DHL_API_KEY=your-dhl-api-key
DHL_API_SECRET=your-dhl-api-secret
DHL_BASE_URL=https://api-eu.dhl.com/post/de/shipping/im/v1

# Level 2 (User): Portokasse account
INTERNETMARKE_USERNAME=your-portokasse-username
INTERNETMARKE_PASSWORD=your-portokasse-password

# Optional override: INTERNETMARKE_BASE_URL takes precedence over DHL_BASE_URL
# INTERNETMARKE_BASE_URL=https://internetmarke.deutschepost.de
